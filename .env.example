# Primary EmailJS account (required to enable order requests).
# These Vite values are included in the browser bundle; use only EmailJS public keys.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_ORDER_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_STORE_EMAIL=

# Optional primary-account templates.
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=
VITE_EMAILJS_REVIEW_TEMPLATE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=

# Independent second EmailJS account used only if the primary returns quota/rate-limit status.
VITE_EMAILJS_BACKUP_SERVICE_ID=
VITE_EMAILJS_BACKUP_ORDER_TEMPLATE_ID=
VITE_EMAILJS_BACKUP_PUBLIC_KEY=

# Optional backup templates: customer falls back to backup order template when blank.
# Add the review/contact backup templates if those email types should also fail over.
VITE_EMAILJS_BACKUP_CUSTOMER_TEMPLATE_ID=
VITE_EMAILJS_BACKUP_REVIEW_TEMPLATE_ID=
VITE_EMAILJS_BACKUP_CONTACT_TEMPLATE_ID=

# Public store contact details. Enter a phone number with country code or a wa.me URL.
VITE_STORE_PHONE=
VITE_FACEBOOK_URL=https://www.facebook.com/share/19eC6JhkrP/
VITE_INSTAGRAM_URL=
VITE_WHATSAPP_URL=+880 1410-604446
